/vis/open OGL
/vis/drawVolume
/vis/viewer/set/viewpointVector 1 1 1
/vis/viewer/zoom 1.5
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set opticalphoton yellow
/vis/modeling/trajectories/drawByParticleID-0/set mu- red
/vis/scene/endOfEventAction accumulate
/vis/geometry/set/colour World 0 0 0 1 0.1
/vis/geometry/set/visibility World 0 true
/vis/geometry/set/colour DOM_Glass 0 0 1 0 0.3
/vis/geometry/set/colour PMT 0 0.5 0.5 0.5 1
/vis/viewer/flush

